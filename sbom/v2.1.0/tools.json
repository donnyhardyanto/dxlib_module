{
  "scanners" : [
    "trivy fs --scanners vuln --exit-code 1 ."
  ],
  "steps" : [
    {
      "command" : "syft dir:. -o cyclonedx-json -o spdx-json",
      "exit" : null,
      "step" : "syft"
    },
    {
      "command" : "grype sbom:dxlib-module-2.1.0.cdx.json -o json",
      "exit" : null,
      "step" : "grype"
    },
    {
      "command" : "osv-scanner scan source -r --allow-no-lockfiles --no-call-analysis=go --format json .",
      "exit" : null,
      "step" : "osv-scanner"
    },
    {
      "command" : "govulncheck -format json ./... in .",
      "exit" : 0,
      "report" : "reports/govulncheck-0.json",
      "step" : "govulncheck-0"
    },
    {
      "command" : "trivy fs --scanners vuln --exit-code 1 .",
      "exit" : null,
      "step" : "scanner-0"
    }
  ],
  "tools" : [
    {
      "name" : "syft",
      "version" : "1.57.1"
    },
    {
      "name" : "grype",
      "version" : "0.121.3"
    },
    {
      "name" : "osv-scanner",
      "version" : "2.7.1"
    },
    {
      "name" : "govulncheck",
      "version" : "v1.9.0"
    }
  ]
}
